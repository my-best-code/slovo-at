---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero';
import Section from '../components/Section';
import CardGrid from '../components/CardGrid';
import { site } from '../data/site';
import { about, contact, hero, offer } from '../data/home';
import { absolute, href } from '../lib/urls';

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: absolute('/', Astro.site),
  inLanguage: 'ru',
  publisher: { '@id': absolute('/#organization', Astro.site) },
};
---

<BaseLayout title={site.name} description="Онлайн-школа немецкого" path="/" jsonLd={[website]}>
  <Hero title={hero.title} text={hero.text} cta={{ ...hero.cta, href: href(hero.cta.href) }} />

  <Section id="ueber-uns" title={about.title} muted>
    {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </Section>

  <Section id="angebot" title={offer.title}>
    <CardGrid items={offer.items} />
  </Section>

  <Section id="kontakt" title={contact.title} muted>
    <p>{contact.text}</p>
    <address>
      {site.legalName}<br />
      {site.address.street}<br />
      {site.address.postalCode} {site.address.city}<br />
      <a href={`mailto:${site.email}`}>{site.email}</a>
      {site.phone && (
        <>
          <br />
          <a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a>
        </>
      )}
    </address>
    {/* Если на Tilda была форма — сюда встанет форма Web3Forms или Formspree. */}
  </Section>
</BaseLayout>
