---
// GitHub Pages сам отдаёт эту страницу на любой несуществующий адрес.
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { href } from '../lib/urls';
---

<BaseLayout title={`Seite nicht gefunden – ${site.name}`} noindex>
  <article class="prose container">
    <h1>Seite nicht gefunden</h1>
    <p>Diese Seite gibt es nicht oder nicht mehr.</p>
    <p><a class="button" href={href('/')}>Zur Startseite</a></p>
  </article>
</BaseLayout>
