---
import Seo from '../components/Seo.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import { site } from '../data/site';
import { defaultLang, getDict, languages, langs, localePath, type Lang } from '../i18n';
import type { ImageKey } from '../lib/images';
import { pageHref } from '../lib/rich';
import { href } from '../lib/urls';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Путь страницы без языка, например '/groups/'. Нужен для меню, переключателя языков и hreflang. */
  path: string;
  lang?: Lang;
  /** Картинка для превью ссылки. По умолчанию — горное озеро, как у главной на Tilda. */
  image?: ImageKey;
  noindex?: boolean;
  /** Для страниц, которые есть только на одном языке (см. Seo.astro). */
  canonicalLang?: Lang;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, lang = defaultLang, image = 'lakeMountains', noindex, canonicalLang, jsonLd } = Astro.props;
const { common } = getDict(lang);

const links = common.nav.map((item) => ({
  label: item.label,
  href: pageHref(item.path, lang),
  current: item.path === path,
  mobileOnly: 'mobileOnly' in item && item.mobileOnly,
}));
const cta = { label: common.navCta.label, href: pageHref(common.navCta.path, lang), current: common.navCta.path === path };
const langLinks = langs.map((code) => ({
  code,
  label: languages[code].label,
  href: href(localePath(code, path)),
  current: code === lang,
}));
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} lang={lang} path={path} image={image} noindex={noindex} canonicalLang={canonicalLang} jsonLd={jsonLd} />
  </head>
  <body>
    <a class="skip-link" href="#main">{common.skipLink}</a>
    {/* Меню-«бургер» нужен только на узких экранах, поэтому JS грузится только там. */}
    <Header
      client:media="(max-width: 980px)"
      siteName={site.name}
      homeHref={pageHref('/', lang)}
      links={links}
      cta={cta}
      langs={langLinks}
      menuLabel={common.menu}
      navLabel={common.navLabel}
      languageLabel={common.languageLabel}
    />
    <main id="main">
      <slot />
    </main>
    <Footer
      legalName={site.legalName}
      email={site.email}
      socials={site.socials}
      impressumHref={pageHref('/impressum/', lang)}
      datenschutzHref={pageHref('/datenschutz/', lang)}
      text={{ ...common.footer, socialsLabel: common.socialsLabel }}
    />
  </body>
</html>
