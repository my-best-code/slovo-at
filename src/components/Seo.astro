---
// Всё, что нужно поисковикам, ИИ-ботам и превью ссылок: title, description,
// canonical, Open Graph, JSON-LD. Подключается в BaseLayout.
import { PRODUCTION_ORIGIN, site } from '../data/site';
import { languages, type Lang } from '../i18n';
import { absolute } from '../lib/urls';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, lang, noindex = false, jsonLd = [] } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
// Тестовый деплой на *.github.io не должен попасть в поиск.
const isProduction = Astro.site?.origin === PRODUCTION_ORIGIN;
const ogImage: string | null = null;

const organization = {
  '@context': 'https://schema.org',
  '@type': site.schemaType,
  '@id': absolute('/#organization', Astro.site),
  name: site.name,
  legalName: site.legalName,
  url: absolute('/', Astro.site),
  email: site.email,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.postalCode,
    addressLocality: site.address.city,
    addressCountry: site.address.country,
  },
  sameAs: site.socials.map((social) => social.url),
};

// '<' экранируем, чтобы текст не мог закрыть тег <script>.
const toJson = (data: unknown) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{(noindex || !isProduction) && <meta name="robots" content="noindex" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={languages[lang].ogLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{ogImage && <meta property="og:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

<link rel="sitemap" href={absolute('/sitemap-index.xml', Astro.site)} />

<script type="application/ld+json" set:html={toJson(organization)} />
{jsonLd.map((data) => <script type="application/ld+json" set:html={toJson(data)} />)}
